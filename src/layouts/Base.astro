---
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  // The home page has its own layout and no header.
  bare?: boolean;
}

const { title, description = site.description, bare = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#181614" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {bare ? (
      <slot />
    ) : (
      <>
        <header class="site-header">
          <div class="wrap"><a class="brand" href="/">← {site.name}</a></div>
        </header>
        <main class="wrap">
          <slot />
        </main>
        <footer class="site-footer">
          <div class="wrap"><div class="inner">
            <span>© 2026 {site.name}</span>
            <span>
              <a href={site.linkedin}>LinkedIn</a> · <a href={site.github}>GitHub</a> ·
              <a class="js-email" href="/#contact">Email</a>
            </span>
          </div></div>
        </footer>
      </>
    )}
    <script>
      // Assemble the address in the browser so it never appears as plain text in the page source.
      const r = (s: string) => s.split('').reverse().join('');
      const addr = r('tniopgninrut') + '@' + r('moc.sdnimdedargnu');
      document.querySelectorAll<HTMLAnchorElement>('.js-email').forEach((a) => {
        a.href = 'mailto:' + addr;
      });
    </script>
  </body>
</html>
