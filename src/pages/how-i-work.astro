---
import Base from '../layouts/Base.astro';
import Flow from '../components/Flow.astro';
import { principles } from '../data/site';
---
<Base title="How I work" description="Six principles I apply to product analytics and data platforms, each with the work where I applied it.">
  <article class="prose">
    <section>
      <p class="eyebrow">How I work</p>
      <h1>Six things I do on every data platform</h1>
      <p class="lede">Each one comes from a platform I've built, linked below, so you can see where it was applied.</p>
    </section>

    <ul class="rows" style="margin-top: 32px;">
      {principles.map((p, i) => (
        <li>
          <div class="meta">0{i + 1}</div>
          <h3>{p.title}</h3>
          <p class="muted" style="margin: 0 0 6px;">{p.body}</p>
          <p style="margin: 0; font-size: 15px;">Where: <a href={p.href}>{p.evidence}</a></p>
        </li>
      ))}
    </ul>

    <h2>A stack I've set up from scratch</h2>
    <p>For an early-stage AI SaaS product, with a small team and no data stack yet:</p>
    <Flow
      steps={[
        { label: 'Ingest', tools: 'dlt, Estuary' },
        { label: 'Warehouse', tools: 'MotherDuck' },
        { label: 'Transform', tools: 'dbt' },
        { label: 'Orchestrate', tools: 'Kestra' },
        { label: 'Self-serve', tools: 'Metabase' },
      ]}
    />
    <p><a href="/work/saas-product-analytics">Read the case study →</a></p>
  </article>
</Base>
