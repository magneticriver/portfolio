---
import Base from '../layouts/Base.astro';
import { site, whatIDo, principles, caseStudies, lab, now, about } from '../data/site';
---
<Base>
  <section>
    <p class="eyebrow">{site.name} · {site.role} · {site.location}</p>
    <h1>{site.headline}</h1>
    <p class="lede">{site.pitch}</p>
    <div class="buttons">
      <a class="btn primary" href="#work">See my work</a>
      <a class="btn" href="/how-i-work">How I work</a>
    </div>
  </section>

  <section>
    <div class="grid">
      {whatIDo.map((c) => (
        <div class="card"><h3>{c.title}</h3><p>{c.body}</p></div>
      ))}
    </div>
  </section>

  <section id="work">
    <div class="section-head"><h2>Selected work</h2></div>
    <div class="grid">
      {caseStudies.map((c) => (
        <a class="card" href={`/work/${c.slug}`}>
          <span class="tag">{c.context}</span>
          <h3>{c.title}</h3>
          <p>{c.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section id="how-i-work">
    <div class="section-head">
      <h2>How I work</h2>
      <a href="/how-i-work">With the evidence →</a>
    </div>
    <div class="grid">
      {principles.map((p, i) => (
        <a class="card" href={p.href}><div class="num">0{i + 1}</div><h3>{p.title}</h3><p>{p.evidence}</p></a>
      ))}
    </div>
  </section>

  <section id="lab">
    <div class="section-head"><h2>AI lab</h2></div>
    <p class="muted">Side projects where data and LLM agents meet. Exploration, not production work.</p>
    <div class="grid">
      {lab.map((l) => (
        <a class="card" href={l.href}>
          <span class="tag">{l.tag}</span>
          <h3>{l.title}</h3>
          <p>{l.body}</p>
          <ul class="chips">{l.stack.map((s) => <li>{s}</li>)}</ul>
        </a>
      ))}
    </div>
  </section>

  <section id="about">
    <div class="section-head"><h2>About</h2></div>
    <div class="about">
      <div class="avatar" aria-hidden="true">MK</div>
      <div>
        <p>{about}</p>
        <h3 style="margin-top: 20px;">Now</h3>
        <ul class="rows">{now.map((n) => <li>{n}</li>)}</ul>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="section-head"><h2>Contact</h2></div>
    <p>{site.openTo}</p>
    <div class="buttons">
      <a class="btn primary js-email" href="#contact">Email me</a>
      <a class="btn" href={site.linkedin}>LinkedIn</a>
      <a class="btn" href={site.github}>GitHub</a>
      <a class="btn" href="/cv">CV</a>
    </div>
    <noscript><p class="muted" style="margin-top: 12px;">Email: turningpoint [at] ungradedminds [dot] com</p></noscript>
  </section>
</Base>
