---
import Base from '../layouts/Base.astro';
import { site, principles, caseStudies, earlier, now, experiments } from '../data/site';
---
<Base>
  <section>
    <img class="portrait" src="/images/mohit.webp" width="88" height="88" alt="Illustrated portrait of Mohit Khanduri" />
    <h1>Hey, I'm Mohit.</h1>
    <p>
      I'm an analytics engineer and solutions architect. I design data platforms and turn product and usage
      data into metrics teams trust: app data modelled in dbt, clear metric definitions, and dashboards
      people can use on their own.
    </p>
    <p>
      I've spent 13 years in software and data, the last 7 building analytics platforms end to end,
      at an early-stage AI startup, an industrial energy company and for a private equity firm's portfolio companies.
      The part I enjoy most is the moment a team agrees on what a metric means and starts using it to decide.
    </p>
    <p>
      I'm open to analytics engineering, data architecture and product analytics roles, in India or remote.
      Reach me by <a class="js-email" href="#contact">email</a>, on <a href={site.linkedin}>LinkedIn</a>,
      or read my <a href="/cv">CV</a>.
    </p>
    <noscript><p class="muted">Email: turningpoint [at] ungradedminds [dot] com</p></noscript>
  </section>

  <section id="work">
    <h2>Experience</h2>
    <ul class="list">
      {caseStudies.map((c) => (
        <li><a href={`/work/${c.slug}`}>
          <div class="t">{c.title}</div>
          <div class="d">{c.summary}</div>
          <div class="m">{c.context}</div>
        </a></li>
      ))}
    </ul>
    <p class="muted" style="margin: 18px 0 6px; font-size: 15px;">Earlier:</p>
    <ul class="bullets">{earlier.map((e) => <li>{e}</li>)}</ul>
    <p style="margin-top: 12px; font-size: 15px;"><a href="/cv">Full experience on the CV →</a></p>
  </section>

  <section id="how-i-work">
    <h2>How I work</h2>
    <ul class="list">
      {principles.map((p, i) => (
        <li><a href={`/how-i-work#p${i + 1}`}>
          <div class="t">{p.title}</div>
          <div class="d">{p.evidence}</div>
        </a></li>
      ))}
    </ul>
  </section>

  <section id="now">
    <h2>Now</h2>
    <ul class="bullets">{now.map((n) => <li>{n}</li>)}</ul>
  </section>

  <section id="experiments">
    <h2>Experiments</h2>
    <p class="muted" style="font-size: 15px;">{experiments} <a href={site.github}>See them on GitHub →</a></p>
  </section>
</Base>
