---
import Base from '../layouts/Base.astro';
import { site, principles, caseStudies, lab, now } from '../data/site';
---
<Base>
  <section>
    <h1>Hey, I'm Mohit.</h1>
    <p>
      I'm a product analytics engineer. I turn product and usage data into metrics teams trust:
      app data modelled in dbt, clear metric definitions, and dashboards people can use on their own.
    </p>
    <p>
      I've spent 13 years in software and data, the last 7 building analytics platforms end to end,
      at an early-stage AI startup, an industrial energy company and across a group of businesses.
      The part I enjoy most is the moment a team agrees on what a metric means and starts using it to decide.
    </p>
    <p>
      Lately I've been building LLM agents on top of governed data. I'm open to product analytics and
      analytics engineering roles, in India or remote. Reach me by <a class="js-email" href="#contact">email</a>,
      on <a href={site.linkedin}>LinkedIn</a> or <a href={site.github}>GitHub</a>, or read my <a href="/cv">CV</a>.
    </p>
    <noscript><p class="muted">Email: turningpoint [at] ungradedminds [dot] com</p></noscript>
  </section>

  <section id="work">
    <h2>Selected work</h2>
    <ul class="list">
      {caseStudies.map((c) => (
        <li><a href={`/work/${c.slug}`}>
          <div class="t">{c.title}</div>
          <div class="d">{c.summary}</div>
          <div class="m">{c.context}</div>
        </a></li>
      ))}
    </ul>
  </section>

  <section id="how-i-work">
    <h2>How I work</h2>
    <ul class="list">
      {principles.map((p, i) => (
        <li><a href={`/how-i-work#p${i + 1}`}>
          <div class="t">{p.title}</div>
          <div class="d">{p.evidence}</div>
        </a></li>
      ))}
    </ul>
  </section>

  <section id="lab">
    <h2>Side projects</h2>
    <ul class="list">
      {lab.map((l) => (
        <li><a href={l.href}>
          <div class="t">{l.title}</div>
          <div class="d">{l.body}</div>
          <div class="m">{l.stack.join(' · ')}</div>
        </a></li>
      ))}
    </ul>
  </section>

  <section id="now">
    <h2>Now</h2>
    <ul class="bullets">{now.map((n) => <li>{n}</li>)}</ul>
  </section>
</Base>
