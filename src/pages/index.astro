---
import Base from '../layouts/Base.astro';
import { site, bio, principles, caseStudies, earlier, now, experiments } from '../data/site';
---
<Base bare>
  <div class="home">
    <main>
      <div class="band"><img src="/images/himalaya-band.webp" width="900" height="369" alt="" /></div>

      <div class="name">
        <img class="portrait" src="/images/mohit.webp" width="64" height="64" alt="Illustrated portrait of Mohit Khanduri" />
        <h1>{site.name}</h1>
      </div>

      <div class="bio-head">
        <span class="meta">Analytics engineer and solutions architect</span>
        <span class="toggle" role="group" aria-label="Bio length">
          <button type="button" aria-pressed="true" data-v="default">Default</button> /
          <button type="button" aria-pressed="false" data-v="long">Long</button>
        </span>
      </div>
      <p>{bio.intro}</p>
      <div class="long" id="bio-long">
        {bio.more.map((p) => <p>{p}</p>)}
      </div>
      <p id="contact">
        {bio.summary} {site.openTo}{' '}
        <a class="js-email" href="#contact">Email</a> · <a href={site.linkedin}>LinkedIn</a> · <a href="/cv">CV</a>
      </p>
      <noscript><p class="meta">Email: turningpoint [at] ungradedminds [dot] com</p></noscript>

      <h2 id="work">Experience</h2>
      <ul class="sq">
        {caseStudies.map((c) => (
          <li><a href={`/work/${c.slug}`}>{c.title}</a><span class="sub">{c.summary}</span></li>
        ))}
      </ul>
      <ul class="sq small">
        {earlier.map((e) => <li>Earlier: {e[0].toLowerCase() + e.slice(1)}</li>)}
        <li><a href="/cv">Full experience on the CV</a></li>
      </ul>

      <h2>How I work</h2>
      <ul class="sq cols">
        {principles.map((p, i) => <li><a href={`/how-i-work#p${i + 1}`}>{p.title}</a></li>)}
      </ul>

      <h2>Now</h2>
      <ul class="sq small">{now.map((n) => <li>{n}</li>)}</ul>

      <h2>Experiments</h2>
      <p class="muted" style="font-size: 16px;">{experiments} <a href={site.github}>See them on GitHub</a></p>

      <footer class="foot">
        <span>© 2026 {site.name}</span>
        <span><a href={site.linkedin}>LinkedIn</a> · <a href={site.github}>GitHub</a> · <a class="js-email" href="#contact">Email</a></span>
      </footer>
    </main>
    <aside class="art">
      <img src="/images/himalaya-tall.webp" width="840" height="870" alt="The Himalayas at dusk, the highest peaks catching the last light" />
    </aside>
  </div>
</Base>

<script>
  // Default / Long bio switch. Without JavaScript the Default bio shows.
  const body = document.body;
  document.querySelectorAll<HTMLButtonElement>('.toggle button').forEach((b) =>
    b.addEventListener('click', () => {
      body.classList.toggle('show-long', b.dataset.v === 'long');
      document.querySelectorAll('.toggle button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    }),
  );
</script>

<style>
  .home { max-width: 1120px; margin: 0 auto; padding: 72px 32px 48px; display: grid;
          grid-template-columns: minmax(0, 580px) minmax(0, 420px); gap: 64px; justify-content: space-between; }
  .art { position: sticky; top: 48px; align-self: start; }
  .art img { width: 100%; height: auto; display: block; }
  .band { display: none; }
  .name { display: flex; align-items: center; gap: 18px; margin-bottom: 28px; }
  .portrait { width: 64px; height: 64px; border-radius: 50%; background: var(--surface); flex: none; }
  h1 { font-size: 44px; margin: 0; }
  .bio-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
  .toggle { font-size: 15px; color: var(--faint); white-space: nowrap; }
  .toggle button { font: inherit; background: none; border: 0; padding: 0; color: var(--faint); cursor: pointer; }
  .toggle button[aria-pressed="true"] { color: var(--text); text-decoration: underline;
                                        text-underline-offset: 4px; text-decoration-color: var(--accent); }
  .long { display: none; }
  :global(body.show-long) .long { display: block; }
  .foot { margin-top: 64px; padding-top: 18px; border-top: 1px solid var(--line); color: var(--faint);
          font-size: 15px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
  .foot a { color: var(--muted); }
  @media (max-width: 860px) {
    .home { grid-template-columns: 1fr; gap: 0; padding: 0 16px 40px; }
    .art { display: none; }
    .band { display: block; margin: 0 -16px 28px; }
    .band img { width: 100%; height: auto; display: block; }
    h1 { font-size: 34px; }
  }
</style>
